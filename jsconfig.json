{
  "compilerOptions": {
    "target": "ESNext",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "baseUrl": ".",
    "paths": {
      "@/*": [
        "src/*"
      ]
    },
    "allowSyntheticDefaultImports": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "checkJs": true,
    "skipLibCheck": true
  },
  "include": [
    "src",
    "Home.jsx"
  ],
  "exclude": [
    "node_modules",
    "dist"
  ]
}